{
  "name": "i-fleur-frontend",
  "version": "1.0.0",
  "description": "Frontend for i.fleur flower boutique",
  "scripts": {
    "dev": "esbuild src/ts/main.ts --bundle --outfile=dist/app.js --format=esm --watch --servedir=.",
